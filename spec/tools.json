[
  {
    "type": "function",
    "name": "log_objection",
    "description": "Registra una objeción ya pronunciada por el cliente simulado en esta sesión. No anuncia evaluación en voz. Cita exacta de un turno AGENT y occurrence entre coincidencias de ese rol.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "objection_id",
        "quote",
        "occurrence"
      ]
    }
  },
  {
    "type": "function",
    "name": "score_rubric",
    "description": "Propone observaciones de conductas del vendedor USER con citas exactas. Ejecutar durante práctica después de cada respuesta evaluable, antes de la siguiente objeción. No enviar totales, pesos ni IDs inventados. Omite criterios no observables. occurrence se cuenta entre turnos USER con esa cita, desde 1.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "criterion_id": {
                "type": "string",
                "enum": [
                  "empathy",
                  "discovery",
                  "objection_handling",
                  "solution_integrity",
                  "closing"
                ]
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "criterion_id",
              "level",
              "quote",
              "occurrence",
              "rationale"
            ]
          }
        }
      },
      "required": [
        "observations"
      ]
    }
  }
]
